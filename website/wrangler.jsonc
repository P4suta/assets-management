{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assets-management-support",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "assets-management.yasunobu.dev", "custom_domain": true }
  ]
}
