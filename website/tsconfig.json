{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["playwright.config.ts", "vite.config.ts", "tests/**/*.ts", "public/**/*.ts"]
}
